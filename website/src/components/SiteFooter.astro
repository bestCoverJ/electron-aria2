---
import { navigation, site } from "@data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/" aria-label="Tide X 首页">
        <img src="/images/tide-logo.png" width="34" height="34" alt="" />
        <span>{site.name}</span>
      </a>
      <p class="muted">内置 aria2 的本地桌面下载管理器。当前版本 {site.version}。</p>
    </div>
    <nav class="nav-links" aria-label="页脚导航">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
